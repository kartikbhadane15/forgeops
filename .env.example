# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/forgeops
DB_USERNAME=forgeops
DB_PASSWORD=change-me-locally

# JWT Security
JWT_SECRET=replace-with-a-long-random-local-secret-32-chars-min
JWT_EXPIRATION_MS=86400000

# Server & CORS Configuration
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

# Incident Analysis (Local deterministic heuristic rules only; no external AI/APIs)
ANALYSIS_MODE=local-rules
